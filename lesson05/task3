const number = 8

let start = 1;
let end = 10;

console.log("\nMultiplication Table by FOR loop:");
for (let i=start; i<=end; i++) {
    console.log(`${number} X ${i} = ${number*i}`);
}

console.log("\nMultiplication Table by WHILE loop:");
let i=start;
while (i<=end) {
    console.log(`${number} X ${i} = ${number*i}`);
    i++;
}